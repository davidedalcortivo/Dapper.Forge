  <ItemGroup>
    <ProjectReference Include="..\..\src\Dapper.Forge.Core\Dapper.Forge.Core.csproj">
      <privateAssets>all</privateAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Dapper.Forge.MySql\Dapper.Forge.MySql.csproj">
      <privateAssets>all</privateAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Dapper.Forge.Oracle\Dapper.Forge.Oracle.csproj">
